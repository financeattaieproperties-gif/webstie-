# Prevent direct public HTTP access to applicant photos and CVs.
# Files in this directory are served exclusively through /api/admin/career-file.php after admin authentication.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
Options -Indexes
