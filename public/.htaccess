Options -Indexes +FollowSymLinks
DirectoryIndex index.html index.php
RewriteEngine On

AddType application/javascript .js .mjs
AddType text/css .css
AddType font/woff2 .woff2
AddType font/woff .woff
AddType image/svg+xml .svg

# Block direct HTTP access to SQL files, bootstrap, and database config files
<FilesMatch "^(db\.php|db\.example\.php|bootstrap\.php|.*\.sql|.*\.migrated)$">
  Require all denied
</FilesMatch>

# Dynamic XML Sitemap (includes all live properties, projects, and agents)
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Do not rewrite missing /api/* endpoints to HTML
RewriteRule ^api/ - [L]

# Admin CRM SPA fallback — routes under /admin/* serve /admin/index.html
RewriteRule ^admin(?:/.*)?$ /admin/index.html [L]

# Block direct HTTP access to private applicant files
RewriteRule ^uploads/private_applications/ - [F,L]

# Dynamic SEO & OpenGraph pre-rendering for Property, Project, Agent, and Career detail pages
RewriteRule ^(properties|projects|agents|careers)/[0-9]+/?$ /seo.php [L]

# Public Website SPA fallback — all other routes serve /index.html
RewriteRule ^ /index.html [L]


