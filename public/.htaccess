Options -Indexes
RewriteEngine On

# Redirect bare root to default locale
RewriteRule ^$ /en/ [R=302,L]

# Admin SPA — serve index.html for all /admin/* paths (React Router handles client-side)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ /admin/index.html [L]

# Property detail — serve the placeholder shell for any property ID not pre-generated
# The client component reads the real ID via useParams() from the URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(en|ar)/properties/([^/]+)/?$ /$1/properties/1/index.html [L]

# Let PHP files in /api/ pass through normally
RewriteRule ^api/ - [L]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# For paths without a trailing slash, redirect to add one
# (matches Next.js trailingSlash: true output)
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/ -d
RewriteRule ^(.+)$ /$1/ [R=301,L]

# Custom error pages
ErrorDocument 404 /en/404.html
